   "source": [
    "%matplotlib inline\n",
    "import copy\n",
    "from study_support import audit_data, save_run_details\n",
    "import hashlib\n",
    "import urllib.request\n",
    "from pathlib import Path\n",
    "\n",
    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import torch\n",
    "from IPython.display import display\n",
    "from sklearn.model_selection import train_test_split\n",
    "from sklearn.preprocessing import OneHotEncoder, StandardScaler\n",
    "from threadpoolctl import threadpool_limits\n",
    "from torch import nn\n",
    "\n",
    "ITERATION = 10\n",
    "HIDDEN_LAYERS = [256, 128]\n",
    "WEIGHT_DECAY = 0.001\n",
    "REDUCE_LEARNING_RATE = True\n",
    "PIECEWISE_BINS = 512\n",
    "SEED = 42\n",
    "DATA_DIR = Path(\"data\")\n",
    "DATA_DIR.mkdir(exist_ok=True)\n",
    "torch.set_num_threads(2)\n",
    "torch.use_deterministic_algorithms(True)\n",
    "\n",
    "\n",
    "def load_author_file(filename, url, expected_sha, expected_rows):\n",
    "    path = DATA_DIR / filename\n",
    "    if not path.exists():\n",
    "        urllib.request.urlretrieve(url, path)\n",
    "    if hashlib.sha256(path.read_bytes()).hexdigest() != expected_sha:\n",
    "        raise ValueError(\"Use the original author data files.\")\n",
    "    data = pd.read_csv(path)\n",
    "    data[\"date\"] = pd.to_datetime(data[\"date\"])\n",
    "    for column in [\"Day_of_week\", \"WeekStatus\"]:\n",
    "        data[column] = data[column].str.strip()\n",
    "    assert len(data) == expected_rows and data[\"date\"].is_unique\n",
    "    return data\n",
    "\n",
    "\n",
    "training = load_author_file(\n",
    "    \"author_training.csv\",\n",
    "    \"https://raw.githubusercontent.com/LuisM78/Appliances-energy-prediction-data/master/training.csv\",\n",
    "    \"9f25388eb73247416173dba43ae7d8657d46fbabc0baabf512f84bdd92492f7f\",\n",
    "    14803,\n",
    ")\n",
    "testing = load_author_file(\n",
    "    \"author_testing.csv\",\n",
    "    \"https://raw.githubusercontent.com/LuisM78/Appliances-energy-prediction-data/master/testing.csv\",\n",
    "    \"9d60780e70db92c3c470286452fca7f28e38ac4a3f420a5ca6d43a39b847e251\",\n",
    "    4932,\n",
    ")\n",
    "\n",
    "physical_columns = [\n",
    "    \"lights\", \"T1\", \"RH_1\", \"T2\", \"RH_2\", \"T3\", \"RH_3\",\n",
    "    \"T4\", \"RH_4\", \"T5\", \"RH_5\", \"T6\", \"RH_6\",\n",
    "    \"T7\", \"RH_7\", \"T8\", \"RH_8\", \"T9\", \"RH_9\",\n",
    "    \"T_out\", \"Press_mm_hg\", \"RH_out\", \"Windspeed\", \"Visibility\", \"Tdewpoint\",\n",
    "]\n",
    "category_columns = [\"Day_of_week\", \"WeekStatus\"]\n",
    "\n",
    "data_audit = audit_data(training, testing, physical_columns)\n",
    "\n",
    "\n",
    "def prepare_features(fitting_data, evaluation_data):\n",
    "    category_encoder = OneHotEncoder(handle_unknown=\"ignore\", sparse_output=False)\n",
    "    category_encoder.fit(fitting_data[category_columns])\n",
    "\n",
    "    def make_original_features(data):\n",
    "        numeric_values = np.column_stack(\n",
    "            [data[physical_columns].to_numpy(float), data[\"NSM\"].to_numpy(float)[:, None]]\n",
    "        )\n",
    "        return np.column_stack([numeric_values, category_encoder.transform(data[category_columns])])\n",
    "\n",
    "    input_scaler = StandardScaler().fit(make_original_features(fitting_data))\n",
    "    train_features = input_scaler.transform(make_original_features(fitting_data))\n",
    "    evaluation_features = input_scaler.transform(make_original_features(evaluation_data))\n",
    "\n",
    "    number_of_numeric_inputs = len(physical_columns) + 1\n",
    "    bin_edges_by_column = [\n",
    "        np.unique(np.quantile(train_features[:, column], np.linspace(0, 1, PIECEWISE_BINS + 1)))\n",
    "        for column in range(number_of_numeric_inputs)\n",
    "    ]\n",
    "\n",
    "    def make_piecewise_features(values):\n",
    "        columns = []\n",
    "        for column, bin_edges in enumerate(bin_edges_by_column):\n",
    "            if len(bin_edges) >= 2:\n",
    "                columns.append(\n",
    "                    np.clip((values[:, column, None] - bin_edges[:-1]) / np.diff(bin_edges), 0, 1)\n",
    "                )\n",
    "        return np.column_stack(columns)\n",
    "\n",
    "    ramp_scaler = StandardScaler().fit(make_piecewise_features(train_features))\n",
    "    training_ramps = ramp_scaler.transform(make_piecewise_features(train_features))\n",
    "    evaluation_ramps = ramp_scaler.transform(make_piecewise_features(evaluation_features))\n",
    "    train_features = np.column_stack([train_features, training_ramps])\n",
    "    evaluation_features = np.column_stack([evaluation_features, evaluation_ramps])\n",
    "    return train_features.astype(np.float32), evaluation_features.astype(np.float32)\n",
    "\n",
    "\n",
    "def fit_network(fitting_data, evaluation_data, fixed_schedule=None):\n",
    "    train_features, evaluation_features = prepare_features(fitting_data, evaluation_data)\n",
    "    train_energy = fitting_data[\"Appliances\"].to_numpy(float)\n",
    "    target_mean = float(train_energy.mean())\n",
    "    target_std = float(train_energy.std())\n",
    "    train_inputs = torch.from_numpy(train_features)\n",
    "    evaluation_inputs = torch.from_numpy(evaluation_features)\n",
    "    scaled_targets = torch.tensor(\n",
    "        (train_energy - target_mean) / target_std, dtype=torch.float32\n",
    "    ).reshape(-1, 1)\n",
    "\n",
    "    torch.manual_seed(SEED)\n",
    "    network_layers = []\n",
    "    input_size = train_features.shape[1]\n",
    "    for hidden_units in HIDDEN_LAYERS:\n",
    "        network_layers.extend([nn.Linear(input_size, hidden_units), nn.ReLU()])\n",
    "        input_size = hidden_units\n",
    "    network_layers.append(nn.Linear(input_size, 1))\n",
    "    network = nn.Sequential(*network_layers)\n",
    "    optimizer = torch.optim.Adam(network.parameters(), lr=0.001, weight_decay=WEIGHT_DECAY)\n",
    "    if REDUCE_LEARNING_RATE and fixed_schedule is None:\n",
    "        scheduler = torch.optim.lr_scheduler.ReduceLROnPlateau(\n",
    "            optimizer, mode=\"min\", factor=0.5, patience=8, min_lr=1e-5\n",
    "        )\n",
    "    else:\n",
    "        scheduler = None\n",
    "    batch_generator = torch.Generator().manual_seed(SEED + 1000)\n",
    "    best_rmse = float(\"inf\")\n",
    "    best_epoch = 0\n",
    "    best_weights = None\n",
    "    training_history = []\n",
    "    if fixed_schedule is None:\n",
    "        epochs = 240\n",
    "    else:\n",
    "        epochs = fixed_schedule[\"best_epoch\"]\n",
    "\n",
    "    for epoch in range(1, epochs + 1):\n",
    "        if fixed_schedule is not None:\n",
    "            optimizer.param_groups[0][\"lr\"] = fixed_schedule[\"learning_rates\"][epoch - 1]\n",
    "        learning_rate = float(optimizer.param_groups[0][\"lr\"])\n",
    "\n",
    "        network.train()\n",
    "        for batch_indices in torch.randperm(len(train_inputs), generator=batch_generator).split(256):\n",
    "            optimizer.zero_grad(set_to_none=True)\n",
    "            loss = nn.functional.mse_loss(\n",
    "                network(train_inputs[batch_indices]), scaled_targets[batch_indices]\n",
    "            )\n",
    "            loss.backward()\n",
    "            optimizer.step()\n",
    "        epoch_result = {\"epoch\": epoch, \"learning_rate\": learning_rate}\n",
    "        if fixed_schedule is None:\n",
    "            network.eval()\n",
    "            with torch.no_grad():\n",
    "                predictions = np.maximum(\n",
    "                    0,\n",
    "                    network(evaluation_inputs).numpy().ravel().astype(float) * target_std + target_mean,\n",
    "                )\n",
    "            validation_rmse = float(\n",
    "                np.sqrt(np.mean((evaluation_data[\"Appliances\"].to_numpy(float) - predictions) ** 2))\n",
    "            )\n",
    "            epoch_result[\"validation_rmse_Wh\"] = validation_rmse\n",
    "            if validation_rmse < best_rmse - 0.01:\n",
    "                best_rmse = validation_rmse\n",
    "                best_epoch = epoch\n",
    "                best_weights = copy.deepcopy(network.state_dict())\n",
    "            if scheduler is not None:\n",
    "                scheduler.step(validation_rmse)\n",
    "            training_history.append(epoch_result)\n",
    "            if epoch - best_epoch >= 25:\n",
    "                break\n",
    "        else:\n",
    "            training_history.append(epoch_result)\n",
    "\n",
    "    if fixed_schedule is None:\n",
    "        network.load_state_dict(best_weights)\n",
    "    else:\n",
    "        best_epoch = epochs\n",
    "    network.eval()\n",
    "    with torch.no_grad():\n",
    "        predictions = np.maximum(\n",
    "            0, network(evaluation_inputs).numpy().ravel().astype(float) * target_std + target_mean\n",
    "        )\n",
    "    training_details = {\n",
    "        \"best_epoch\": best_epoch,\n",
    "        \"learning_rates\": [row[\"learning_rate\"] for row in training_history[:best_epoch]],\n",
    "        \"history\": training_history,\n",
    "        \"input_width\": train_features.shape[1],\n",
    "        \"parameters\": sum(parameter.numel() for parameter in network.parameters()),\n",
    "    }\n",
    "    return predictions, training_details\n",
    "\n",
    "\n",
    "def calculate_scores(observed_energy, predicted_energy):\n",
    "    observed_energy = np.asarray(observed_energy, dtype=float)\n",
    "    error = observed_energy - predicted_energy\n",
    "    return {\n",
    "        \"RMSE_Wh\": float(np.sqrt(np.mean(error**2))),\n",
    "        \"MAE_Wh\": float(np.mean(np.abs(error))),\n",
    "        \"R_squared\": float(\n",
    "            1 - np.sum(error**2) / np.sum((observed_energy - observed_energy.mean()) ** 2)\n",
    "        ),\n",
    "    }\n",
    "\n",
    "\n",
    "energy_groups = pd.qcut(training[\"Appliances\"], 5, duplicates=\"drop\")\n",
    "fit_indices, validation_indices = train_test_split(\n",
    "    np.arange(len(training)), test_size=0.2, random_state=20261025, stratify=energy_groups\n",
    ")\n",
    "print(f\"Run {ITERATION}: training...\")\n",
    "with threadpool_limits(limits=2):\n",
    "    schedule_predictions, training_plan = fit_network(\n",
    "        training.iloc[fit_indices], training.iloc[validation_indices]\n",
    "    )\n",
    "\n",
    "    validation_scores = []\n",
    "    for split_seed in [20261030, 20261031, 20261032]:\n",
    "        fit_indices, validation_indices = train_test_split(\n",
    "            np.arange(len(training)), test_size=0.2, random_state=split_seed, stratify=energy_groups\n",
    "        )\n",
    "        predictions, _ = fit_network(\n",
    "            training.iloc[fit_indices], training.iloc[validation_indices], training_plan\n",
    "        )\n",
    "        split_scores = {\n",
    "            \"split_seed\": split_seed,\n",
    "            **calculate_scores(training.iloc[validation_indices][\"Appliances\"], predictions),\n",
    "        }\n",
    "        validation_scores.append(split_scores)\n",
    "\n",
    "    test_predictions, final_fit = fit_network(training, testing, training_plan)\n",
    "\n",
    "test_metrics = calculate_scores(testing[\"Appliances\"], test_predictions)\n",
    "validation_table = pd.DataFrame(validation_scores)\n",
    "comparison = pd.DataFrame(\n",
    "    [\n",
    "        {\n",
    "            \"Evaluation\": \"Validation: mean of three splits (seed 42)\",\n",
    "            **validation_table.drop(columns=\"split_seed\").mean().to_dict(),\n",
    "        },\n",
    "        {\"Evaluation\": \"Author test: this single NN (seed 42)\", **test_metrics},\n",
    "        {\n",
    "            \"Evaluation\": \"Author test: paper GBM, Table 5\",\n",
    "            \"RMSE_Wh\": 66.65,\n",
    "            \"MAE_Wh\": 35.22,\n",
    "            \"R_squared\": 0.57,\n",
    "        },\n",
    "    ]\n",
    ")\n",
    "display(comparison.round({\"RMSE_Wh\": 2, \"MAE_Wh\": 2, \"R_squared\": 3}))\n",
    "display(validation_table.round({\"RMSE_Wh\": 2, \"MAE_Wh\": 2, \"R_squared\": 3}))\n",
    "\n",
    "result_folder = Path(\"results\") / f\"run_{ITERATION:02d}\"\n",
    "result_folder.mkdir(parents=True, exist_ok=True)\n",
    "comparison.to_csv(result_folder / \"scores.csv\", index=False)\n",
    "validation_table.to_csv(result_folder / \"validation.csv\", index=False)\n",
    "pd.DataFrame(training_plan[\"history\"]).to_csv(result_folder / \"training_history.csv\", index=False)\n",
    "pd.DataFrame({\n",
    "    \"date\": testing[\"date\"],\n",
    "    \"observed_Wh\": testing[\"Appliances\"],\n",
    "    \"predicted_Wh\": test_predictions,\n",
    "}).to_csv(result_folder / \"test_predictions.csv\", index=False)\n",
    "pd.DataFrame([{\n",
    "    \"run\": ITERATION,\n",
    "    \"initialization_seed\": SEED,\n",
    "    \"batch_order_seed\": SEED + 1000,\n",
    "    \"hidden_layers\": str(HIDDEN_LAYERS),\n",
    "    \"weight_decay\": WEIGHT_DECAY,\n",
    "    \"learning_rate_reduction\": REDUCE_LEARNING_RATE,\n",
    "    \"requested_bins\": PIECEWISE_BINS,\n",
    "    \"selected_epochs\": training_plan[\"best_epoch\"],\n",
    "    \"inputs\": final_fit[\"input_width\"],\n",
    "    \"parameters\": final_fit[\"parameters\"],\n",
    "}]).to_csv(result_folder / \"configuration.csv\", index=False)\n",
    "print(f\"Selected epochs: {training_plan['best_epoch']}; inputs: {final_fit['input_width']}; \"\n",
    "      f\"parameters: {final_fit['parameters']:,}\")\n",
    "\n",
    "\n",
    "\n",
    "fig, axes = plt.subplots(1, 2, figsize=(10, 3.5), layout=\"constrained\")\n",
    "training_history = pd.DataFrame(training_plan[\"history\"])\n",
    "axes[0].plot(training_history[\"epoch\"], training_history[\"validation_rmse_Wh\"])\n",
    "axes[0].axvline(training_plan[\"best_epoch\"], color=\"gray\", linestyle=\"--\", label=\"Selected checkpoint\")\n",
    "axes[0].set(xlabel=\"Schedule-selection epoch\", ylabel=\"Validation RMSE (Wh)\")\n",
    "axes[0].legend()\n",
    "axes[1].scatter(testing[\"Appliances\"], test_predictions, s=7, alpha=0.2)\n",
    "upper = max(float(testing[\"Appliances\"].max()), float(test_predictions.max()))\n",
    "axes[1].plot([0, upper], [0, upper], \"k--\")\n",
    "axes[1].set(\n",
    "    xlabel=\"Measured energy (Wh)\",\n",
    "    ylabel=\"Predicted energy (Wh)\",\n",
    "    title=f\"Author test - Run {ITERATION}\",\n",
    ")\n",
    "fig.savefig(result_folder / \"diagnostics.png\", dpi=150, bbox_inches=\"tight\")\n",
    "plt.show()\n",
    "plt.close(fig)\n",
    "\n",
    "\n",
    "# Extra exports do not change fitting, preprocessing, or scoring.\n",
    "save_run_details(result_folder, training, testing, test_predictions,\n",
    "                 training_plan, final_fit, data_audit)\n"
