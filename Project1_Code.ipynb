      "text/html": "<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>split_seed</th>\n      <th>RMSE_Wh</th>\n      <th>MAE_Wh</th>\n      <th>R_squared</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th>0</th>\n      <td>20261030</td>\n      <td>71.66</td>\n      <td>31.95</td>\n      <td>0.544</td>\n    </tr>\n    <tr>\n      <th>1</th>\n      <td>20261031</td>\n      <td>70.78</td>\n      <td>31.51</td>\n      <td>0.545</td>\n    </tr>\n    <tr>\n      <th>2</th>\n      <td>20261032</td>\n      <td>72.94</td>\n      <td>33.04</td>\n      <td>0.489</td>\n    </tr>\n  </tbody>\n</table>"
