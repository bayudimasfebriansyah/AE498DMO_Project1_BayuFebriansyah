      "text/html": "<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>Evaluation</th>\n      <th>RMSE_Wh</th>\n      <th>MAE_Wh</th>\n      <th>R_squared</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th>0</th>\n      <td>Validation: mean of three splits (seed 42)</td>\n      <td>71.79</td>\n      <td>32.17</td>\n      <td>0.526</td>\n    </tr>\n    <tr>\n      <th>1</th>\n      <td>Author test: this single NN (seed 42)</td>\n      <td>65.66</td>\n      <td>29.44</td>\n      <td>0.582</td>\n    </tr>\n    <tr>\n      <th>2</th>\n      <td>Author test: paper GBM, Table 5</td>\n      <td>66.65</td>\n      <td>35.22</td>\n      <td>0.570</td>\n    </tr>\n  </tbody>\n</table>"
